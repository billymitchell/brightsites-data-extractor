BRIGHTSITES_STORES={"shop-a":{"subdomain":"shop-a","token":"replace-with-api-token","label":"Shop A"}}

# Legacy single-store configuration (used when BRIGHTSITES_STORES is not set)
# BRIGHTSITES_SUBDOMAIN=shop-a
# BRIGHTSITES_API_TOKEN=replace-with-api-token

# Optional report-job limits
# REPORT_JOB_MAX_ACTIVE=2
# REPORT_JOB_MAX_RETAINED_RESULTS=5
# REPORT_MAX_ROWS=50000
# Authentication: password (existing shared login) or email (Supabase one-time codes)
# AUTH_MODE=password
# Required in production with AUTH_MODE=password
# APP_PASSWORD=change-me-long-random
# Required for either mode; at least 32 characters for email mode
# SESSION_SECRET=output-of-openssl-rand-hex-32
# SESSION_TTL_MS=28800000
# Required with AUTH_MODE=email (configure Supabase email OTP and custom SMTP first)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-project-publishable-or-legacy-anon-key
# Account column defaults: run supabase/migrations/20261103000000_report_column_preferences.sql
# Server-only secret key (or legacy service_role key); never use a publishable/anon key here
# SUPABASE_SECRET_KEY=

# Optional UPS tracking lookup (create an app at developer.ups.com, enable the Tracking API)
# UPS_CLIENT_ID=
# UPS_CLIENT_SECRET=
